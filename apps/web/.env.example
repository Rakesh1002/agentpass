# Cloudflare AI Gateway key used by /api/audit to generate the personalized
# security tip after a waitlist signup. Provision via:
#   wrangler secret put AI_GATEWAY_API_KEY
# Locally, copy this file to .env.local and fill in a dev key.
AI_GATEWAY_API_KEY=

# Salt for hashing visitor IPs in the waitlist rate limiter.
# Generate a fresh random string per environment; do NOT reuse across
# dev/staging/prod.
WAITLIST_IP_SALT=
